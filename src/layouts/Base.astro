---
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts.mjs";

interface Props {
  title?: string;
  description?: string;
  /** チャート系ページで本文コンテナを1280pxまで広げる（3列グリッド用） */
  wide?: boolean;
}

const { title, description = SITE_DESCRIPTION, wide = false } = Astro.props;
const pageTitle = title ? `${title}｜${SITE_TITLE}` : SITE_TITLE;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site);

const path = Astro.url.pathname;
const navItems = [
  { href: base, label: "ホーム", exact: true },
  { href: `${base}fx/`, label: "FX" },
  { href: `${base}metals/`, label: "貴金属" },
  { href: `${base}crypto/`, label: "暗号資産" },
  { href: `${base}us-stocks/`, label: "米国株" },
];
const isActive = (item) =>
  item.exact ? path === item.href : path.startsWith(item.href);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="theme-color" content="#0f5aa8" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:image" content={new URL("og-image.png", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_TITLE}
      href={new URL("rss.xml", Astro.site)}
    />
    <script
      is:inline
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5741786934832383"
      crossorigin="anonymous"></script>
  </head>
  <body>
    <header>
      <a class="site-title" href={base}>{SITE_TITLE}</a>
      <p class="tagline">毎営業日、朝夕2回更新の市況まとめ</p>
      <nav class="site-nav">
        {
          navItems.map((it) => (
            <a
              href={it.href}
              class:list={[{ active: isActive(it) }]}
              aria-current={isActive(it) ? "page" : undefined}
            >
              {it.label}
            </a>
          ))
        }
      </nav>
    </header>
    <main class:list={[{ wide }]}>
      <slot />
    </main>
    <footer>
      <nav class="footer-nav">
        <a href={base}>ホーム</a>
        <a href={`${base}fx/`}>FX</a>
        <a href={`${base}metals/`}>貴金属</a>
        <a href={`${base}crypto/`}>暗号資産</a>
        <a href={`${base}us-stocks/`}>米国株</a>
        <a href={`${base}archive/`}>記事アーカイブ</a>
        <a href={`${base}rss.xml`}>RSS</a>
      </nav>
      <p class="footer-links">
        <a href={`${base}about/`}>運営者情報</a>
        <a href={`${base}contact/`}>お問い合わせ</a>
        <a href={`${base}privacy/`}>プライバシーポリシー</a>
        <a href={`${base}disclaimer/`}>免責事項</a>
      </p>
      <p>© {new Date().getFullYear()} {SITE_TITLE}</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --text: #1a2233;
    --muted: #5b6577;
    --accent: #0f5aa8;
    --bg: #f7f8fa;
    --card: #ffffff;
    --border: #dde3ea;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: "Hiragino Sans", "Yu Gothic", "Meiryo", sans-serif;
    color: var(--text);
    background: var(--bg);
    line-height: 1.8;
  }
  header {
    background: var(--card);
    border-bottom: 1px solid var(--border);
    padding: 1.2rem 1rem;
    text-align: center;
    /* スクロールしてもヘッダーを画面上部に固定する */
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: 0 1px 4px rgba(26, 34, 51, 0.06);
  }
  .site-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text);
    text-decoration: none;
  }
  .tagline { margin: 0.3rem 0 0; font-size: 0.85rem; color: var(--muted); }
  .site-nav {
    margin-top: 0.6rem;
    display: flex;
    gap: 0.2rem 1rem;
    justify-content: center;
    flex-wrap: wrap;
    font-size: 0.9rem;
  }
  .site-nav a {
    color: var(--accent);
    text-decoration: none;
    padding: 0.1rem 0.2rem 0.2rem;
    border-bottom: 2px solid transparent;
  }
  .site-nav a:hover { border-bottom-color: var(--border); }
  .site-nav a.active {
    font-weight: 700;
    color: var(--text);
    border-bottom-color: var(--accent);
  }
  main { max-width: 760px; margin: 0 auto; padding: 1.5rem 1rem 3rem; }
  /* チャート系ページはコンテナごと広げる（グリッドは中で自然に中央揃えになる）。
     本文の段落は読みやすい幅に留める */
  main.wide { max-width: 1280px; }
  main.wide > p { max-width: 50rem; }
  footer {
    border-top: 1px solid var(--border);
    padding: 1.5rem 1rem;
    text-align: center;
    font-size: 0.85rem;
    color: var(--muted);
  }
  footer a { color: var(--accent); text-decoration: none; }
  footer a:hover { text-decoration: underline; }
  .footer-nav {
    display: flex;
    gap: 0.3rem 1.2rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 0.8rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--border);
  }
  .footer-links {
    display: flex;
    gap: 0.3rem 1.2rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  h1 { font-size: 1.45rem; line-height: 1.5; }
  h2 {
    font-size: 1.15rem;
    border-left: 4px solid var(--accent);
    padding-left: 0.6rem;
    margin-top: 2rem;
  }
  table {
    border-collapse: collapse;
    width: 100%;
    margin: 1rem 0;
    background: var(--card);
    font-size: 0.92rem;
  }
  th, td { border: 1px solid var(--border); padding: 0.45rem 0.6rem; text-align: left; }
  th { background: #eef2f7; }
  a { color: var(--accent); }
  /* スマホでは幅の広い表を横スクロールさせ、本文のはみ出しを防ぐ */
  @media (max-width: 640px) {
    table {
      display: block;
      max-width: 100%;
      overflow-x: auto;
    }
  }
</style>
