---
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts.mjs";

interface Props {
  title?: string;
  description?: string;
  /** チャート系ページで本文コンテナを1280pxまで広げる（3列グリッド用） */
  wide?: boolean;
  /** 会員向けページなど、検索結果に載せたくないページで true にする */
  noindex?: boolean;
}

const {
  title,
  description = SITE_DESCRIPTION,
  wide = false,
  noindex = false,
} = Astro.props;
const pageTitle = title ? `${title}｜${SITE_TITLE}` : SITE_TITLE;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site);

const path = Astro.url.pathname;
const navItems = [
  { href: base, label: "ホーム", exact: true },
  { href: `${base}fx/`, label: "FX" },
  { href: `${base}metals/`, label: "貴金属" },
  { href: `${base}crypto/`, label: "暗号資産" },
  { href: `${base}jp-stocks/`, label: "日本株" },
  { href: `${base}us-stocks/`, label: "米国株" },
  { href: `${base}account/`, label: "マイページ" },
];
const isActive = (item) =>
  item.exact ? path === item.href : path.startsWith(item.href);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="theme-color" content="#0f5aa8" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:image" content={new URL("og-image.png", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_TITLE}
      href={new URL("rss.xml", Astro.site)}
    />
    {
      /* 広告は一般向けページだけ。会員ページ（noindex）に出さないのは、
         確認・停止リンクの ?u=…&t=… を含むページURLが広告配信先へ渡るのを防ぐため。 */
      !noindex && (
        <script
          is:inline
          async
          src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5741786934832383"
          crossorigin="anonymous"
        />
      )
    }
  </head>
  <body>
    <header>
      <div class="header-top">
        <p class="site-summary">
          初心者の投資家にも、ベテランにも分かりやすいシンプルＡＩ生成による市況ブログ
        </p>
        <a class="site-title" href={base}>{SITE_TITLE}</a>
        <p class="header-promo">
          <a href={`${base}account/register/`}>会員登録は無料</a>
          <span class="header-promo-note">
            気になる銘柄だけを選んで表示できます
          </span>
        </p>
      </div>
      <nav class="site-nav">
        {
          navItems.map((it) => (
            <a
              href={it.href}
              class:list={[{ active: isActive(it) }]}
              aria-current={isActive(it) ? "page" : undefined}
            >
              {it.label}
            </a>
          ))
        }
      </nav>
    </header>
    <main class:list={[{ wide }]}>
      <slot />
    </main>
    <footer>
      <nav class="footer-nav">
        <a href={base}>ホーム</a>
        <a href={`${base}fx/`}>FX</a>
        <a href={`${base}metals/`}>貴金属</a>
        <a href={`${base}crypto/`}>暗号資産</a>
        <a href={`${base}jp-stocks/`}>日本株</a>
        <a href={`${base}us-stocks/`}>米国株</a>
        <a href={`${base}account/`}>マイページ</a>
        <a href={`${base}archive/`}>記事アーカイブ</a>
        <a href={`${base}rss.xml`}>RSS</a>
      </nav>
      <p class="footer-links">
        <a href={`${base}about/`}>運営者情報</a>
        <a href={`${base}contact/`}>お問い合わせ</a>
        <a href={`${base}terms/`}>会員規約</a>
        <a href={`${base}privacy/`}>プライバシーポリシー</a>
        <a href={`${base}disclaimer/`}>免責事項</a>
      </p>
      <p>© {new Date().getFullYear()} {SITE_TITLE}</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --text: #1a2233;
    --muted: #5b6577;
    --accent: #0f5aa8;
    --bg: #f7f8fa;
    --card: #ffffff;
    --border: #dde3ea;
    /* 注目ニュースの重要度（高・中・低）を示す色 */
    --lv-high: #bf2c2c;
    --lv-mid: #b06a00;
    --lv-low: #8a94a6;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: "Hiragino Sans", "Yu Gothic", "Meiryo", sans-serif;
    color: var(--text);
    background: var(--bg);
    line-height: 1.8;
  }
  /* ヘッダーは占有する高さを従来の約半分に抑え、空いた横幅に
     左＝サイト概要、中央＝サイト名、右＝会員登録の案内を並べる */
  header {
    background: var(--card);
    border-bottom: 1px solid var(--border);
    padding: 0.3rem 1rem;
    line-height: 1.5;
    /* スクロールしてもヘッダーを画面上部に固定する */
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: 0 1px 4px rgba(26, 34, 51, 0.06);
  }
  .header-top,
  .site-nav { max-width: 1280px; margin-left: auto; margin-right: auto; }
  /* 両側を同じ幅の列にしてサイト名を中央に置く。折り返して2行にならないよう、
     あふれる概要だけを省略記号で切り、ヘッダーの高さは画面幅によらず一定にする */
  .header-top {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: baseline;
    gap: 1.5rem;
  }
  /* 列を明示しておく。概要を隠す幅でも、サイト名は中央・案内は右のまま */
  .site-title {
    grid-column: 2;
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--accent);
    text-decoration: none;
    white-space: nowrap;
    text-align: center;
  }
  .site-summary {
    grid-column: 1;
    margin: 0;
    min-width: 0;
    font-size: 0.78rem;
    color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  /* min-width は既定（auto）のまま。案内文は省略できないので、
     列が狭いときは切り詰めずに列側を広げる（サイト名の中央は多少ずれる） */
  .header-promo {
    grid-column: 3;
    margin: 0;
    font-size: 0.78rem;
    text-align: right;
    white-space: nowrap;
  }
  .header-promo a { font-weight: 700; }
  .header-promo-note { color: var(--muted); margin-left: 0.4rem; }
  .site-nav {
    margin-top: 0.25rem;
    display: flex;
    gap: 0.2rem 1rem;
    flex-wrap: wrap;
    font-size: 0.88rem;
  }
  .site-nav a {
    color: var(--accent);
    text-decoration: none;
    padding: 0.1rem 0.2rem 0.2rem;
    border-bottom: 2px solid transparent;
  }
  .site-nav a:hover { border-bottom-color: var(--border); }
  .site-nav a.active {
    font-weight: 700;
    color: var(--text);
    border-bottom-color: var(--accent);
  }
  main { max-width: 760px; margin: 0 auto; padding: 1.5rem 1rem 3rem; }
  /* チャート系ページはコンテナごと広げる（グリッドは中で自然に中央揃えになる）。
     本文の段落は読みやすい幅に留める */
  main.wide { max-width: 1280px; }
  main.wide > p { max-width: 50rem; }
  footer {
    border-top: 1px solid var(--border);
    padding: 1.5rem 1rem;
    text-align: center;
    font-size: 0.85rem;
    color: var(--muted);
  }
  footer a { color: var(--accent); text-decoration: none; }
  footer a:hover { text-decoration: underline; }
  .footer-nav {
    display: flex;
    gap: 0.3rem 1.2rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 0.8rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--border);
  }
  .footer-links {
    display: flex;
    gap: 0.3rem 1.2rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  h1 { font-size: 1.45rem; line-height: 1.5; }
  h2 {
    font-size: 1.15rem;
    border-left: 4px solid var(--accent);
    padding-left: 0.6rem;
    margin-top: 2rem;
  }
  table {
    border-collapse: collapse;
    width: 100%;
    margin: 1rem 0;
    background: var(--card);
    font-size: 0.92rem;
  }
  th, td { border: 1px solid var(--border); padding: 0.45rem 0.6rem; text-align: left; }
  th { background: #eef2f7; }
  a { color: var(--accent); }

  /* 「注目ニュース」のカード（src/rehype-news-importance.mjs が組み立てる）。
     どれを優先して読めばよいかが一目で分かるよう、重要度を
     左の色帯・バッジ・見出しの濃さの3点で示す */
  .news-legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.2rem 0.7rem;
    margin: 0.6rem 0 1rem;
    font-size: 0.78rem;
    color: var(--muted);
  }
  .news-legend-item { white-space: nowrap; }
  .news-legend-item.lv-high { color: var(--lv-high); font-weight: 700; }
  .news-legend-item.lv-mid { color: var(--lv-mid); }
  .news-legend-item.lv-low { color: var(--lv-low); }
  .news-item {
    background: var(--card);
    border: 1px solid var(--border);
    border-left: 5px solid var(--lv-low);
    border-radius: 8px;
    padding: 0.9rem 1.1rem 1rem;
    margin: 0.9rem 0;
  }
  .news-item h3 {
    margin: 0.15rem 0 0.5rem;
    font-size: 1.02rem;
    line-height: 1.6;
  }
  .news-item p { margin: 0.5rem 0; }
  /* 「一般的な影響：」の箇条書きは、見出しと区別できるよう淡い枠に収める */
  .news-item ul {
    list-style: none;
    margin: 0.7rem 0 0;
    padding: 0.55rem 0.8rem;
    background: #f4f7fb;
    border-radius: 6px;
    font-size: 0.93rem;
  }
  .news-item ul li + li { margin-top: 0.5rem; }
  .news-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0;
    padding: 0.05rem 0.5rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .news-dots { letter-spacing: 0.08em; }
  /* 重要度：高＝相場全体、中＝一部の市場、低＝参考 */
  .news-item--high {
    border-left-color: var(--lv-high);
    box-shadow: 0 1px 6px rgba(191, 44, 44, 0.1);
  }
  .news-item--high .news-badge { background: #fdecec; color: var(--lv-high); }
  .news-item--high h3 { color: var(--lv-high); }
  .news-item--mid { border-left-color: var(--lv-mid); }
  .news-item--mid .news-badge { background: #fdf3e2; color: var(--lv-mid); }
  .news-item--low { border-left-color: var(--lv-low); }
  .news-item--low .news-badge { background: #eef1f5; color: var(--lv-low); }
  /* 低い項目は控えめに見せて、上位との差をつける */
  .news-item--low h3 { font-weight: 600; color: var(--muted); }

  /* 会員機能（登録・ログイン・マイページ）で共有するフォーム部品 */
  .card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.1rem 1.2rem 1.3rem;
    margin: 1.2rem 0;
  }
  .card > h2:first-child { margin-top: 0; }
  .field { display: block; margin-bottom: 1rem; }
  .field > span {
    display: block;
    font-size: 0.88rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
  }
  .field input {
    width: 100%;
    font: inherit;
    padding: 0.45rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: 5px;
    background: #fff;
    color: var(--text);
  }
  .field input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
  .field-hint {
    display: block;
    font-size: 0.8rem;
    font-weight: 400;
    color: var(--muted);
    margin-top: 0.2rem;
  }
  .btn {
    display: inline-block;
    background: var(--accent);
    color: #fff;
    border: 1px solid var(--accent);
    border-radius: 5px;
    padding: 0.4rem 1rem;
    font: inherit;
    font-size: 0.95rem;
    text-decoration: none;
    cursor: pointer;
  }
  .btn:hover { filter: brightness(1.08); }
  .btn:disabled { opacity: 0.55; cursor: default; filter: none; }
  .btn-ghost { background: transparent; color: var(--accent); }
  .btn-danger { background: transparent; color: #cf222e; border-color: #cf222e; }
  .btn-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin: 0;
  }
  .form-msg {
    margin: 0.8rem 0 0;
    font-size: 0.9rem;
    padding: 0.5rem 0.7rem;
    border-radius: 5px;
  }
  .form-msg:empty { display: none; }
  .form-msg.error { background: #fdecec; color: #a4232b; }
  .form-msg.ok { background: #e9f6ec; color: #14612d; }

  /* スマホでは幅の広い表を横スクロールさせ、本文のはみ出しを防ぐ */
  @media (max-width: 640px) {
    table {
      display: block;
      max-width: 100%;
      overflow-x: auto;
    }
    /* 横に並べる余裕がないので、ヘッダーは要点だけ残す。
       サイト名は中央のまま、少しだけ小さくして左右の列に場所を譲る */
    .header-top { align-items: center; gap: 0.75rem; }
    .site-summary { display: none; }
    .site-title { font-size: 1.2rem; }
  }
  /* 中くらいの幅では、まず右側の補足を落としてサイト概要の表示を優先する */
  @media (max-width: 980px) {
    .header-promo-note { display: none; }
  }
</style>
