---
// 銘柄一覧を30分足チャートのグリッドで表示する（PCは3列・スマホは1列）。
// 各ブロックから銘柄の詳細ページ（1分足・30分足・日足）へリンクする。
// チャートの遅延読み込みは src/lib/tv-widgets.js に共通化してある。
const { pairs } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<div class="chart-grid">
  {
    pairs.map((p) => {
      const detail = `${base}charts/${p.id}/`;
      return (
        <section class="grid-item" data-symbol-id={p.id}>
          <h2>
            <a href={detail}>
              {p.name}（{p.pair}）
            </a>
          </h2>
          <div class="tv-wrapper">
            <div class="tradingview-widget-container" data-tv-chart data-tv-symbol={p.symbol}>
              <div class="tradingview-widget-container__widget" />
            </div>
          </div>
          <p class="detail-link">
            <a href={detail}>1分足・日足チャートを見る →</a>
          </p>
        </section>
      );
    })
  }
</div>

<script>
  import { mountAdvancedChart, loadWhenVisible } from "../lib/tv-widgets.js";

  loadWhenVisible(document.querySelectorAll("[data-tv-chart]"), (el) =>
    mountAdvancedChart(el, {
      symbol: el.dataset.tvSymbol,
      interval: "30",
      hideTopToolbar: true,
    }),
  );
</script>

<style>
  .chart-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.2rem;
    margin: 1.5rem 0;
  }
  .grid-item h2 {
    margin: 0 0 0.5rem;
    font-size: 1.05rem;
    border-left: 4px solid var(--accent);
    padding-left: 0.6rem;
  }
  .grid-item h2 a {
    color: var(--text);
    text-decoration: none;
  }
  .grid-item h2 a:hover {
    color: var(--accent);
  }
  .tv-wrapper {
    height: 340px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .grid-item:hover .tv-wrapper {
    border-color: var(--accent);
    box-shadow: 0 1px 5px rgba(15, 90, 168, 0.15);
  }
  .tradingview-widget-container,
  .tradingview-widget-container__widget {
    height: 100%;
    width: 100%;
  }
  .detail-link {
    margin: 0.4rem 0 0;
    font-size: 0.85rem;
    text-align: right;
  }
  @media (min-width: 900px) {
    /* wideコンテナ（最大1280px）の中で3列に並べる */
    .chart-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
