---
// 銘柄一覧を30分足チャートのグリッドで表示する（PCは3列・スマホは1列）。
// 各ブロックから銘柄の詳細ページ（1分足・30分足・日足）へリンクする。
const { pairs } = Astro.props;
const base = import.meta.env.BASE_URL;
const items = pairs.map((p) => ({
  id: `grid-${p.id}`,
  symbol: p.symbol,
  name: p.name,
  pair: p.pair,
  detail: `${base}charts/${p.id}/`,
}));
---

<div class="chart-grid">
  {
    items.map((it) => (
      <section class="grid-item">
        <h2>
          <a href={it.detail}>
            {it.name}（{it.pair}）
          </a>
        </h2>
        <div class="tv-wrapper">
          <div class="tradingview-widget-container" id={it.id}>
            <div class="tradingview-widget-container__widget" />
          </div>
        </div>
        <p class="detail-link">
          <a href={it.detail}>1分足・日足チャートを見る →</a>
        </p>
      </section>
    ))
  }
</div>

<script is:inline define:vars={{ items }} type="module">
  // 画面内に入った時だけウィジェットを読み込む（遅延読み込み）。
  // 一覧ページはチャート数が多く、全件を即時読み込むと表示が重くなるため。
  function loadWidget(container, it) {
    const s = document.createElement("script");
    s.type = "text/javascript";
    s.src =
      "https://s3.tradingview.com/external-embedding/embed-widget-advanced-chart.js";
    s.async = true;
    s.innerHTML = JSON.stringify({
      autosize: true,
      symbol: it.symbol,
      interval: "30",
      timezone: "Asia/Tokyo",
      theme: "light",
      style: "1",
      locale: "ja",
      hide_side_toolbar: true,
      allow_symbol_change: false,
      calendar: false,
      support_host: "https://www.tradingview.com",
    });
    container.appendChild(s);
  }

  const byId = new Map(items.map((it) => [it.id, it]));
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        observer.unobserve(entry.target);
        const it = byId.get(entry.target.id);
        if (it) loadWidget(entry.target, it);
      }
    },
    { rootMargin: "400px 0px" },
  );

  for (const it of items) {
    const container = document.getElementById(it.id);
    if (container) observer.observe(container);
  }
</script>

<style>
  .chart-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.2rem;
    margin: 1.5rem 0;
  }
  .grid-item h2 {
    margin: 0 0 0.5rem;
    font-size: 1.05rem;
    border-left: 4px solid var(--accent);
    padding-left: 0.6rem;
  }
  .grid-item h2 a {
    color: var(--text);
    text-decoration: none;
  }
  .grid-item h2 a:hover {
    color: var(--accent);
  }
  .tv-wrapper {
    height: 340px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .grid-item:hover .tv-wrapper {
    border-color: var(--accent);
    box-shadow: 0 1px 5px rgba(15, 90, 168, 0.15);
  }
  .tradingview-widget-container,
  .tradingview-widget-container__widget {
    height: 100%;
    width: 100%;
  }
  .detail-link {
    margin: 0.4rem 0 0;
    font-size: 0.85rem;
    text-align: right;
  }
  @media (min-width: 900px) {
    /* wideコンテナ（最大1280px）の中で3列に並べる */
    .chart-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
