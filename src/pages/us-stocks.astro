---
import Base from "../layouts/Base.astro";
import AffiliateSlot from "../components/AffiliateSlot.astro";
import SymbolPicker from "../components/SymbolPicker.astro";
import StockGrid from "../components/StockGrid.astro";
import StockCard from "../components/StockCard.astro";
import ChartDisclaimer from "../components/ChartDisclaimer.astro";
import { US_STOCKS } from "../us-stocks-data.mjs";
import { jstDateLabel } from "../lib/dates.mjs";
import notes from "../../content/us-stocks.json";

// 銘柄メタ情報（US_STOCKS）に、自動生成された解説（content/us-stocks.json）を
// ティッカーで突き合わせてマージする。解説が未生成の銘柄はチャートのみ表示。
const stocks = US_STOCKS.map((s) => ({ ...s, ...(notes.stocks?.[s.ticker] ?? {}) }));
const updatedAt = jstDateLabel(notes.generatedAt);

const title = "米国株 注目銘柄 チャート・株価・前日比一覧";
const description =
  "アルファベット・アマゾン・アップル・マイクロソフト・エヌビディア・テスラなど米国の注目銘柄の株価、前日比、リアルタイムチャートと解説をまとめて確認できます。";
---

<Base title={title} description={description} wide noAds>
  <h1>米国株 注目銘柄</h1>
  <p>
    注目の米国株について、<strong
      >①チャート・②現在の株価（ドル）・③前日比・④解説（現状と公表されている企業の動向）</strong
    >をまとめました。株価はリアルタイム表示（遅延を含む場合があります）です。
  </p>
  {updatedAt && <p class="updated-at">解説の最終更新：{updatedAt}</p>}

  <SymbolPicker pageKey="us-stocks" />

  <StockGrid>
    {
      stocks.map((s) => (
        <StockCard
          name={s.name}
          ticker={s.ticker}
          tvSymbol={s.symbol}
          current={s.current}
          updates={s.updates}
        >
          <div class="tv-info" data-tv-info>
            <div class="tradingview-widget-container__widget" />
          </div>
          <div class="tv-wrapper">
            <div class="tradingview-widget-container" data-tv-chart>
              <div class="tradingview-widget-container__widget" />
            </div>
          </div>
        </StockCard>
      ))
    }
  </StockGrid>

  <AffiliateSlot name="us-stocks" />

  <ChartDisclaimer variant="stocks-tv" />
</Base>

<script>
  import {
    mountAdvancedChart,
    mountSymbolInfo,
    loadWhenVisible,
  } from "../lib/tv-widgets.js";

  // 画面内に入った銘柄カードだけウィジェット（銘柄情報＋チャート）を読み込む。
  loadWhenVisible(document.querySelectorAll("[data-tv-symbol]"), (card) => {
    const symbol = card.dataset.tvSymbol;
    const info = card.querySelector("[data-tv-info]");
    const chart = card.querySelector("[data-tv-chart]");
    if (info) mountSymbolInfo(info, { symbol });
    if (chart) mountAdvancedChart(chart, { symbol, interval: "D", hideTopToolbar: true });
  });
</script>

<style>
  .updated-at {
    margin: 0.2rem 0 0;
    font-size: 0.8rem;
    color: var(--muted);
  }
  /* 米国株カードは幅の狭い3列でウィジェットを収めるため左右を少し詰める */
  .stock-block {
    padding-left: 0.7rem;
    padding-right: 0.7rem;
  }
  /* シンボル情報ウィジェット（ロゴ・株価・EPS等）:
     TradingView が設定する iframe の高さが実際の内容より低く、指標行が切れるため、
     全体を75%に縮小した上で高さをこちらで明示的に確保する */
  .tv-info {
    height: 195px; /* 260px × 0.75 */
    margin-bottom: 0.6rem;
    overflow: hidden;
  }
  .tv-info :global(iframe) {
    width: 133% !important; /* 縮小分だけ広げて実質幅を保つ（1/0.75） */
    height: 260px !important;
    transform: scale(0.75);
    transform-origin: top left;
  }
  /* 1列表示で横に広い中間幅では、ウィジェットが1行レイアウトになるため低くてよい */
  @media (min-width: 640px) and (max-width: 899.98px) {
    .tv-info {
      height: 90px; /* 120px × 0.75 */
    }
    .tv-info :global(iframe) {
      height: 120px !important;
    }
  }
  .tv-wrapper {
    height: 340px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
  }
  /* height:100% はチャート（.tv-wrapper 内）にだけ適用する。
     .tv-info に適用すると情報ウィジェットが潰れて数値が欠ける */
  .tv-wrapper .tradingview-widget-container,
  .tv-wrapper .tradingview-widget-container__widget {
    height: 100%;
    width: 100%;
  }
</style>
