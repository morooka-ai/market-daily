---
import Base from "../../layouts/Base.astro";
import AffiliateSlot from "../../components/AffiliateSlot.astro";
import { CHART_PAIRS } from "../../chart-pairs.mjs";

export function getStaticPaths() {
  return CHART_PAIRS.map((p) => ({ params: { id: p.id }, props: { pair: p } }));
}

const { pair } = Astro.props;
const base = import.meta.env.BASE_URL;

const charts = [
  {
    id: "chart-1m",
    interval: "1",
    heading: "1分足",
    note: "超短期のスキャルピング向け。",
  },
  {
    id: "chart-30m",
    interval: "30",
    heading: "30分足",
    note: "デイトレード向け。当日のトレンド確認に。",
  },
  {
    id: "chart-1d",
    interval: "D",
    heading: "日足",
    note: "スイング・中長期向け。大きな流れの把握に。",
  },
];

const siblings = CHART_PAIRS.filter(
  (p) => p.category === pair.category && p.id !== pair.id,
);
const categoryLabel = pair.category === "fx" ? "FX" : "暗号資産";
const categoryHref = pair.category === "fx" ? `${base}fx/` : `${base}crypto/`;
const slotName = pair.category === "fx" ? "fx-page" : "crypto-page";

const title = `${pair.name}（${pair.pair}）チャート`;
const description = `${pair.name}（${pair.pair}）のリアルタイムチャートを1分足・30分足・日足で表示。スキャルピングからスイングまで、時間軸ごとの値動きを無料で確認できます。`;
---

<Base title={title} description={description}>
  <h1>{pair.name}（{pair.pair}）チャート</h1>
  <p>{pair.lead}チャートは操作でき、テクニカル指標の追加や期間の変更も可能です。</p>

  <div class="timeframe-grid">
    {
      charts.map((c) => (
        <section class="chart-block">
          <h2>{pair.name} {c.heading}</h2>
          <p class="chart-note">{c.note}</p>
          <div class="tv-wrapper">
            <div class="tradingview-widget-container" id={c.id}>
              <div class="tradingview-widget-container__widget" />
            </div>
          </div>
        </section>
      ))
    }
  </div>

  <AffiliateSlot name={slotName} />

  <section class="related">
    <h2>{categoryLabel}のその他のチャート</h2>
    <ul>
      {
        siblings.map((p) => (
          <li>
            <a href={`${base}charts/${p.id}/`}>
              {p.name}（{p.pair}）チャート
            </a>
          </li>
        ))
      }
    </ul>
    <p class="category-links">
      <a href={categoryHref}>{categoryLabel}チャート一覧 →</a>
      <a href={`${base}us-stocks/`}>米国株 注目銘柄チャート →</a>
    </p>
  </section>

  <p class="source-note">
    チャート提供：<a
      href="https://jp.tradingview.com/"
      target="_blank"
      rel="noopener">TradingView</a
    >。表示レートには遅延が含まれる場合があります。取引の判断はご自身の責任で行ってください。詳しくは<a
      href={`${base}disclaimer/`}>免責事項</a
    >をご覧ください。
  </p>
</Base>

<script
  is:inline
  define:vars={{ charts, symbol: pair.symbol }}
  type="module"
>
  for (const c of charts) {
    const container = document.getElementById(c.id);
    if (!container) continue;
    const s = document.createElement("script");
    s.type = "text/javascript";
    s.src =
      "https://s3.tradingview.com/external-embedding/embed-widget-advanced-chart.js";
    s.async = true;
    s.innerHTML = JSON.stringify({
      autosize: true,
      symbol,
      interval: c.interval,
      timezone: "Asia/Tokyo",
      theme: "light",
      style: "1",
      locale: "ja",
      hide_side_toolbar: true,
      allow_symbol_change: false,
      calendar: false,
      support_host: "https://www.tradingview.com",
    });
    container.appendChild(s);
  }
</script>

<style>
  .timeframe-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.2rem;
    margin: 1.5rem 0;
  }
  .chart-block {
    margin: 0;
  }
  .chart-block h2 {
    margin: 0 0 0.2rem;
    font-size: 1.05rem;
  }
  .chart-note {
    margin: 0.2rem 0 0.6rem;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .tv-wrapper {
    height: 380px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
  }
  .tradingview-widget-container,
  .tradingview-widget-container__widget {
    height: 100%;
    width: 100%;
  }
  .related ul {
    padding-left: 1.2rem;
  }
  .category-links {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .source-note {
    margin-top: 2rem;
    font-size: 0.82rem;
    color: var(--muted);
  }
  @media (min-width: 900px) {
    /* 本文コンテナ（760px）を超えて最大1200pxまで広げ、3列を確保する */
    .timeframe-grid {
      grid-template-columns: repeat(3, 1fr);
      width: min(1200px, calc(100vw - 2rem));
      position: relative;
      left: 50%;
      transform: translateX(-50%);
    }
  }
</style>
