---
import Base from "../../layouts/Base.astro";
import { FX_PAIRS, METAL_PAIRS, CRYPTO_PAIRS } from "../../chart-pairs.mjs";

const base = import.meta.env.BASE_URL;
const title = "チャート一覧";
const description =
  "FX主要通貨ペア・ゴールド・暗号資産・米国株のリアルタイムチャートを無料で確認できます。";

const groups = [
  { label: "FX", href: `${base}fx/`, pairs: FX_PAIRS },
  { label: "貴金属", href: `${base}metals/`, pairs: METAL_PAIRS },
  { label: "暗号資産", href: `${base}crypto/`, pairs: CRYPTO_PAIRS },
];
---

<Base title={title} description={description}>
  <h1>チャート一覧</h1>
  <p>
    各銘柄のリアルタイムチャートを<strong>1分足・30分足・日足</strong>で表示しています。見たい銘柄を選んでください。
  </p>

  {
    groups.map((g) => (
      <section>
        <h2>
          <a href={g.href}>{g.label}</a>
        </h2>
        <ul class="chart-list">
          {g.pairs.map((p) => (
            <li>
              <a href={`${base}charts/${p.id}/`}>
                {p.name}（{p.pair}）チャート
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  <section>
    <h2><a href={`${base}jp-stocks/`}>日本株</a></h2>
    <ul class="chart-list">
      <li>
        <a href={`${base}jp-stocks/`}>日本株 主要銘柄</a>
        <span class="sub">株価・前日比・解説（チャートなし）</span>
      </li>
    </ul>
  </section>

  <section>
    <h2><a href={`${base}us-stocks/`}>米国株</a></h2>
    <ul class="chart-list">
      <li>
        <a href={`${base}us-stocks/`}>米国株 注目銘柄</a>
        <span class="sub">株価・前日比・チャート・解説</span>
      </li>
    </ul>
  </section>
</Base>

<style>
  .chart-list {
    list-style: none;
    padding: 0;
  }
  .chart-list li {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.7rem 1rem;
    margin-bottom: 0.6rem;
  }
  .chart-list a {
    font-weight: 600;
    text-decoration: none;
  }
  .sub {
    display: block;
    font-size: 0.8rem;
    color: var(--muted);
  }
</style>
