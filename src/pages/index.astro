---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { SITE_TITLE } from "../consts.mjs";

const allPosts = (await getCollection("posts")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
// トップは直近14件（約1週間分）のみ。それ以前はアーカイブページへ
const posts = allPosts.slice(0, 14);
const hasMore = allPosts.length > posts.length;
const base = import.meta.env.BASE_URL;
const fmt = new Intl.DateTimeFormat("ja-JP", {
  dateStyle: "long",
  timeZone: "Asia/Tokyo",
});
---

<Base noAds>
  <h1>最新の記事</h1>
  <div class="schedule-note">
    <p class="schedule-title">更新時間の目安（毎営業日）</p>
    <ul class="schedule-list">
      <li>
        <span class="badge morning">朝刊</span>
        <strong>7:30 ごろ</strong>（前夜の米国市場・NYクローズ後）
      </li>
      <li>
        <span class="badge evening">夕刊</span>
        <strong>16:00 ごろ</strong>（東証の大引け後）
      </li>
    </ul>
    <p class="schedule-caption">
      時刻はいずれも日本時間の目安です。市場の休場日や配信状況により、時間が前後したり配信をお休みする場合があります。
    </p>
  </div>
  <ul class="post-list">
    {
      posts.map((post) => (
        <li>
          <span class={`badge ${post.data.edition}`}>
            {post.data.edition === "morning"
              ? "朝刊"
              : post.data.edition === "evening"
                ? "夕刊"
                : "お知らせ"}
          </span>
          <a href={`${base}posts/${post.id}/`}>{post.data.title}</a>
          <time datetime={post.data.pubDate.toISOString()}>
            {fmt.format(post.data.pubDate)}
          </time>
        </li>
      ))
    }
  </ul>
  {posts.length === 0 && <p>記事はまだありません。</p>}
  {
    hasMore && (
      <p class="archive-link">
        <a href={`${base}archive/`}>過去の記事一覧（アーカイブ）→</a>
      </p>
    )
  }

  <section class="about-site">
    <h2>マーケットデイリーについて</h2>
    <p>
      「{SITE_TITLE}」は、JOPEFIC合同会社が運営するマーケット情報サイトです。トレーダーが必要とする情報だけを厳選し、初心者からベテランまで使える、シンプルで使い勝手のよいサイトを目指しています。
    </p>
    <p>
      記事は、取引所や公的機関が公表する市場データと報道をもとに、AI（人工知能）が下書きを作成しています。生成にあたっては、個別銘柄の売買推奨を行わないことを条件として指定しています。AIによる生成物の性質上、数値・固有名詞・日付に誤りが含まれる可能性があるため、投資判断に用いる際は必ず一次情報（取引所や発行会社などの公表資料）をご確認ください。掲載内容は情報提供のみを目的としており、特定の金融商品の売買を推奨・勧誘するものではありません（詳しくは<a
        href={`${base}disclaimer/`}>免責事項</a
      >をご覧ください）。
    </p>
    <p>
      市況記事のほか、主要な通貨ペア・貴金属・暗号資産のリアルタイムチャートと値動きの解説、米国株・日本株の注目銘柄の株価と前日比もまとめています。<a
        href={`${base}account/register/`}>無料の会員登録</a
      >をすると、各ページに表示する銘柄を選んで保存できます（設定は端末をまたいで反映されます）。気になる用語や数値にはひとことの解説を添えていますので、ぜひクリックして確かめてみてください。
    </p>
  </section>
</Base>

<style>
  .schedule-note {
    background: #eaf3fb; /* 落ち着いたパステルブルー（記事一覧の白カードと差別化） */
    border: 1px solid #cfe2f3;
    border-radius: 6px;
    padding: 0.9rem 1rem;
    margin-bottom: 1.4rem;
  }
  .schedule-title {
    margin: 0 0 0.6rem;
    font-size: 0.9rem;
    font-weight: 700;
  }
  .schedule-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .schedule-list li { font-size: 0.9rem; }
  .schedule-caption {
    margin: 0.7rem 0 0;
    font-size: 0.78rem;
    color: var(--muted);
    line-height: 1.6;
  }
  .post-list { list-style: none; padding: 0; }
  .post-list li {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.8rem 1rem;
    margin-bottom: 0.7rem;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .post-list li:hover {
    border-color: var(--accent);
    box-shadow: 0 1px 4px rgba(15, 90, 168, 0.15);
  }
  .post-list a { font-weight: 600; text-decoration: none; }
  .post-list time { display: block; font-size: 0.8rem; color: var(--muted); }
  .badge {
    display: inline-block;
    font-size: 0.72rem;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    margin-right: 0.5rem;
    color: #fff;
  }
  .badge.morning { background: #d98123; }
  .badge.evening { background: #33508a; }
  .badge.notice { background: #6b7280; }
  .archive-link { text-align: center; margin-top: 1.5rem; }
  .about-site {
    margin-top: 2.5rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--border);
    font-size: 0.9rem;
  }
  .about-site h2 { margin-top: 0; }
  .about-site p { margin: 0.7rem 0; }
</style>
