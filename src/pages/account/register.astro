---
import Base from "../../layouts/Base.astro";
import { MAX_SELECTION } from "../../catalog.mjs";

const base = import.meta.env.BASE_URL;
const configured = Boolean(
  import.meta.env.PUBLIC_FIREBASE_API_KEY &&
    import.meta.env.PUBLIC_FIREBASE_PROJECT_ID &&
    import.meta.env.PUBLIC_FIREBASE_APP_ID,
);

const title = "無料会員登録";
const description =
  "メールアドレスとパスワードで登録できる無料会員です。各ページに表示する銘柄を選べます。毎日のメール配信を受け取るかどうかは任意で選べます。";
---

<Base title={title} description={description} noindex>
  <h1>無料会員登録</h1>
  <p>登録は無料です。メールアドレスとパスワードだけで始められます。</p>
  <ul class="benefits">
    <li>
      FX・貴金属・暗号資産・日本株・米国株の各ページで、表示する銘柄を<strong
        >最大{MAX_SELECTION}件</strong
      >まで選択・並べ替えできます
    </li>
    <li>設定はアカウントに保存され、別の端末でも同じ表示になります</li>
    <li>
      毎日のメール配信は<strong>希望する方のみ</strong
      >です。登録しただけでは配信されません（下のチェックはあとから変更できます）
    </li>
  </ul>

  {
    !configured ? (
      <p class="card">
        会員機能は現在準備中です。公開までしばらくお待ちください。
      </p>
    ) : (
      <form class="card" data-register-form>
        <label class="field">
          <span>メールアドレス</span>
          <input type="email" name="email" autocomplete="email" required />
          <span class="field-hint">
            ログインIDになります。パスワードを忘れたときの再設定にも使います。
          </span>
        </label>
        <label class="field">
          <span>パスワード</span>
          <input
            type="password"
            name="password"
            autocomplete="new-password"
            required
            minlength="8"
          />
          <span class="field-hint">8文字以上。</span>
        </label>
        <label class="field">
          <span>パスワード（確認）</span>
          <input
            type="password"
            name="passwordConfirm"
            autocomplete="new-password"
            required
            minlength="8"
          />
        </label>

        <label class="opt-in">
          <input type="checkbox" name="subscribe" />
          <span>
            <strong>毎日のメール配信を受け取る（任意）</strong>
            <span class="opt-in-note">
              選んだ銘柄の最新の価格・前日比と当日の記事を、毎営業日1回お届けします。登録後に確認メールをお送りし、その中のリンクを開いていただいた時点で配信を開始します。いつでも停止できます。
            </span>
          </span>
        </label>

        <label class="agree">
          <input type="checkbox" name="agree" required />
          <span>
            <a href={`${base}terms/`}>会員規約</a>と
            <a href={`${base}privacy/`}>プライバシーポリシー</a>に同意します
          </span>
        </label>

        <p class="btn-row">
          <button class="btn" type="submit" data-submit>
            登録する
          </button>
          <a class="btn btn-ghost" href={`${base}account/login/`}>
            登録済みの方はログイン
          </a>
        </p>
        <p class="form-msg" data-msg role="status" />
      </form>
    )
  }
</Base>

<script>
  import { register, toMessage } from "../../lib/firebase.mjs";

  const form = document.querySelector("[data-register-form]");
  if (form) {
    const msg = form.querySelector("[data-msg]");
    const submit = form.querySelector("[data-submit]");
    const base = import.meta.env.BASE_URL;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const email = String(data.get("email") ?? "");
      const password = String(data.get("password") ?? "");
      const confirm = String(data.get("passwordConfirm") ?? "");

      msg.className = "form-msg";
      if (password !== confirm) {
        msg.classList.add("error");
        msg.textContent = "パスワードと確認用パスワードが一致しません。";
        return;
      }

      submit.disabled = true;
      msg.textContent = "登録しています…";
      try {
        await register(email, password, { subscribe: data.get("subscribe") === "on" });
        msg.classList.add("ok");
        msg.textContent = "登録しました。マイページへ移動します…";
        location.href = `${base}account/`;
      } catch (err) {
        submit.disabled = false;
        msg.classList.add("error");
        msg.textContent = toMessage(err);
      }
    });
  }
</script>

<style>
  .benefits {
    font-size: 0.95rem;
    padding-left: 1.2rem;
  }
  .opt-in {
    display: flex;
    align-items: start;
    gap: 0.5rem;
    background: #eef2f7;
    border-radius: 6px;
    padding: 0.7rem 0.8rem;
    margin-bottom: 1rem;
    font-size: 0.92rem;
  }
  .opt-in input {
    margin-top: 0.35rem;
  }
  .opt-in-note {
    display: block;
    font-size: 0.85rem;
    color: var(--muted);
    margin-top: 0.2rem;
  }
  .agree {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }
</style>
