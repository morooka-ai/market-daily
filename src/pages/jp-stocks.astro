---
import Base from "../layouts/Base.astro";
import AffiliateSlot from "../components/AffiliateSlot.astro";
import SymbolPicker from "../components/SymbolPicker.astro";
import StockGrid from "../components/StockGrid.astro";
import StockCard from "../components/StockCard.astro";
import ChartDisclaimer from "../components/ChartDisclaimer.astro";
import { JP_STOCKS } from "../jp-stocks-data.mjs";
import { jstDateLabel } from "../lib/dates.mjs";
import notes from "../../content/jp-stocks.json";

// 東証銘柄はTradingViewの外部埋め込みウィジェットが使えない（データ提供元のライセンス制限）ため、
// このページはチャートを掲載せず、Yahoo Financeの株価データ（quote）とAI解説をカードで表示する。
const stocks = JP_STOCKS.map((s) => ({ ...s, ...(notes.stocks?.[s.ticker] ?? {}) }));
const updatedAt = jstDateLabel(notes.generatedAt);

const yen = new Intl.NumberFormat("ja-JP", { maximumFractionDigits: 1 });

const title = "日本株 主要銘柄 株価・前日比一覧";
const description =
  "トヨタ・ソニー・ソフトバンクグループ・キーエンス・任天堂・NTT・三菱UFJ・東京エレクトロン・アドバンテスト・村田製作所など東証プライムの主要銘柄の株価、前日比、解説をまとめて確認できます。";
---

<Base title={title} description={description} wide noAds>
  <h1>日本株 主要銘柄</h1>
  <p>
    東証プライム市場の主要銘柄について、<strong
      >①現在の株価（円）・②前日比・③解説（現状と公表されている企業の動向）</strong
    >をまとめました。
  </p>
  <p class="note">
    東証銘柄はデータ提供元のライセンス制限により、当サイトで採用しているチャートウィジェットでの掲載ができません。そのため本ページはチャートを掲載せず、株価と解説のみを表示しています。
  </p>
  {updatedAt && <p class="updated-at">最終更新：{updatedAt}</p>}

  <SymbolPicker pageKey="jp-stocks" />

  <StockGrid>
    {
      stocks.map((s) => (
        <StockCard name={s.name} ticker={s.ticker} current={s.current} updates={s.updates}>
          {s.quote ? (
            <p class="quote">
              <span class="price">¥{yen.format(s.quote.price)}</span>
              {s.quote.change != null && (
                <span class:list={["change", { up: s.quote.change >= 0, down: s.quote.change < 0 }]}>
                  {s.quote.change >= 0 ? "+" : ""}
                  {yen.format(s.quote.change)} (
                  {s.quote.change >= 0 ? "+" : ""}
                  {s.quote.changePercent?.toFixed(2)}%)
                </span>
              )}
            </p>
          ) : (
            <p class="quote quote-na">株価データを取得できませんでした</p>
          )}
        </StockCard>
      ))
    }
  </StockGrid>

  <AffiliateSlot name="jp-stocks" />

  <ChartDisclaimer variant="stocks-yahoo" />
</Base>

<style>
  .note {
    font-size: 0.85rem;
    color: var(--muted);
  }
  .updated-at {
    margin: 0.2rem 0 0;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .quote {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin: 0 0 0.7rem;
  }
  .price {
    font-size: 1.5rem;
    font-weight: 700;
  }
  .change {
    font-size: 0.95rem;
    font-weight: 600;
  }
  .change.up {
    color: #1a7f37;
  }
  .change.down {
    color: #cf222e;
  }
  .quote-na {
    font-size: 0.85rem;
    color: var(--muted);
  }
</style>
