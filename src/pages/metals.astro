---
import Base from "../layouts/Base.astro";
import CategoryCharts from "../components/CategoryCharts.astro";
import { METAL_PAIRS } from "../chart-pairs.mjs";

const title = "貴金属チャート一覧（金・プラチナ・銀）";
const description =
  "金（ゴールド）・プラチナ（白金）・銀（シルバー）のリアルタイム30分足チャートを一覧表示。各銘柄の1分足・日足チャートも無料で確認できます。";
---

<Base title={title} description={description} wide noAds>
  <CategoryCharts
    heading="貴金属チャート一覧"
    pageKey="metals"
    pairs={METAL_PAIRS}
    affiliate="metals-page"
    picker={false}
  >
    <p>
      金・プラチナ・銀のドル建て価格の<strong>リアルタイム30分足チャート</strong
      >を一覧表示しています。銘柄名をクリックすると、1分足・30分足・日足を掲載した各銘柄の詳細ページを開けます。
    </p>
  </CategoryCharts>
</Base>
