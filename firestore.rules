rules_version = '2';

// マーケットデイリー 会員機能のアクセス制御。
//
// PUBLIC_FIREBASE_* の設定値はブラウザに埋め込まれる公開情報なので、
// 実質的な防御はすべてこのルールで行う。
//
// 反映方法:
//   firebase deploy --only firestore:rules
// もしくは Firebase コンソールの Firestore → ルール に貼り付けて公開する。

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {

      // --- 本人（ログイン中の会員）------------------------------------------
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      // 1ページあたりの選択銘柄は0〜12件。未設定（キー無し）も許可する。
      // 上限は src/catalog.mjs の MAX_SELECTION と合わせること。
      function selectionOk(sel, key) {
        return !(key in sel)
            || (sel[key] is list && sel[key].size() <= 12);
      }

      function validSelections() {
        let sel = request.resource.data.selections;
        return sel is map
            && sel.keys().hasOnly(['fx', 'metals', 'crypto', 'jp-stocks', 'us-stocks'])
            && selectionOk(sel, 'fx')
            && selectionOk(sel, 'metals')
            && selectionOk(sel, 'crypto')
            && selectionOk(sel, 'jp-stocks')
            && selectionOk(sel, 'us-stocks');
      }

      // 会員のメールアドレスとパスワードは Firebase Authentication 側が持つ。
      // この文書には設定内容だけを置き、想定外のキーは受け付けない。
      // （'mail' は配信機能を廃止する前に作られた会員ドキュメントとの互換のため
      //   許可リストには残すが、現在のフロントは書き込まない）
      function validProfile() {
        return request.resource.data.keys()
                 .hasOnly(['selections', 'mail', 'createdAt', 'updatedAt'])
            && validSelections();
      }

      // --- 権限 --------------------------------------------------------------
      // 読み取りは本人のみ。一覧取得（list）はどこからも許可しない。
      allow get: if isOwner();
      allow list: if false;

      allow create: if isOwner() && validProfile();

      allow update: if isOwner() && validProfile();

      allow delete: if isOwner();
    }

    // 上記以外のパスはすべて拒否する
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
